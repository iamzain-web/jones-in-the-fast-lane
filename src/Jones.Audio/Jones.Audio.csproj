<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 so BOTH Jones.App (net10.0) and Jones.Tests (net8.0) can reference it.
      Nothing here touches a platform API: it is arithmetic over the game's own bytes,
      so the planned Android head gets the same sound the Windows head does.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A C# port of nukeykt's Nuked-OPL3, the die-accurate YMF262 emulator. Its own test
      suite asserts bit-for-bit parity with the reference C implementation, which is why
      it is worth a dependency rather than a hand-rolled FM core: the whole point of this
      file set is that the notes come out with the instruments the game shipped, and an
      approximate chip would undo that at the last step.

      Zero transitive dependencies, pure managed, netstandard2.1/net8.0/net10.0.
      LGPL-2.1-only, consumed unmodified as a NuGet package.

      This project sits outside src/Jones.App/Directory.Packages.props, so the version is
      pinned here the same way Jones.Tests pins xunit.
    -->
    <PackageReference Include="NukedOPL3Sharp" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The original music, as plain text. Embedded rather than copied next to the binary
      because the Android head has no file system to copy to: an APK asset has to be read
      through the platform's own asset manager, and an embedded resource is read the same
      way on both heads with no per-head code at all.

      These are SOURCE. They are meant to be edited by hand - see the header comment in
      demo-town.score for the format.
    -->
    <EmbeddedResource Include="Original\Scores\*.score" />
  </ItemGroup>

</Project>
