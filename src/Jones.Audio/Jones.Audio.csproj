<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 so BOTH Jones.App (net10.0) and Jones.Tests (net8.0) can reference it.
      Nothing here touches a platform API, and since the AdLib path was removed nothing
      here has ANY dependency at all: it is arithmetic, so both heads get the same sound.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    NO PACKAGE REFERENCES, AND THAT IS THE POINT.

    This project used to reference NukedOPL3Sharp, a C# port of nukeykt's Nuked-OPL3, to
    emulate the AdLib card Sierra's arrangements were written for. That whole path is gone:
    the game plays music written for this project on a synthesiser written for this project,
    so there is no chip to emulate and no instrument bank to read.

    Removing it also removed the only two licence questions the audio layer had - the
    LGPL-2.1 on that package, and the GPL on ScummVM, whose SCI AdLib driver the deleted
    SciAdLibDriver.cs was a port of. Neither applies to code that no longer exists.
  -->

  <ItemGroup>
    <!--
      The original music, as plain text. Embedded rather than copied next to the binary
      because the Android head has no file system to copy to: an APK asset has to be read
      through the platform's own asset manager, and an embedded resource is read the same
      way on both heads with no per-head code at all.

      These are SOURCE. They are meant to be edited by hand - see the header comment in
      demo-town.score for the format.
    -->
    <EmbeddedResource Include="Original\Scores\*.score" />
  </ItemGroup>

</Project>
