keys:   .    .    Db4+F4+Ab4   -    -    -    -    .    .    .    Db4+F4+Ab4   -    -    -    -    -
keys:   .    .    Db4+F4+Ab4   -    -    -    -    .    .    .    F4+Ab4+Db5   -    -    -    -    -
keys:   .    .    Db4+F4+Ab4+C5 -   -    -    -    .    .    .    Db4+F4+Ab4+C5 -   -    -    -    -
keys:   .    .    Db4+F4+Ab4+C5 -   -    -    -    .    .    .    Ab4+C5+F5   -    -    -    -    -
keys:   .    .    F4+Bb4+C5   -    -    -    -    .    .    .    F4+Bb4+C5   -    -    -    -    -
keys:   .    .    E4+Bb4+C5   -    -    -    -    .    .    .    E4+G4+Bb4   -    -    -    -    -

lead:   .    .    .    .    C5   -    -    -    -    -    -    -    .    .    .    .
