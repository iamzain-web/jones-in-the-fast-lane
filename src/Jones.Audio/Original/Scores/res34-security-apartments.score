drums:  bd   .    .    hh   .    .    .    hh   .    .    .    hh   .    .    .    hh
drums:  bd   .    .    hh   .    .    .    hh   .    .    .    hh   .    .    .    hh
drums:  bd   .    .    hh   .    .    .    hh   .    .    .    hh   .    .    .    hh
drums:  bd   .    .    hh   .    .    .    hh   .    .    .    hh   .    .    .    oh


