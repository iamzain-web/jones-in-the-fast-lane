pad:    Gb2+Bb2+Db3+F3   -    -    -    -    -    -    -    -    -    -    -    -    -    -    -
pad:    Gb2+Bb2+Db3+F3   -    -    -    -    -    -    -    -    -    -    -    -    -    -    -
pad:    Eb3+Gb3+Bb3+Db4  -    -    -    -    -    -    -    -    -    -    -    -    -    -    -
pad:    Eb3+Gb3+Bb3+Db4  -    -    -    -    -    -    -    -    -    -    -    -    -    -    -
pad:    F2+Ab2+C3+Eb3    -    -    -    -    -    -    -    -    -    -    -    -    -    -    -
pad:    F2+Ab2+C3+Eb3    -    -    -    -    -    -    -    -    -    -    -    -    -    -    -

