keys:   Ab4+C5+Eb5       -    -    -    -    -    -    -    -    -    -    -    -    .    .    .
keys:   Ab4+C5+Eb5       -    -    -    -    -    -    -    -    -    -    -    Eb4+Ab4+C5    -    -    -

clav:   .    .    Bb4+Db5   .    .    .    .    .    .    .    Bb4+Db5   .    .    F4+Bb4    .    .
clav:   .    .    Ab4+Db5   .    .    .    .    .    .    .    Ab4+Db5   .    .    F4+Ab4    .    .
