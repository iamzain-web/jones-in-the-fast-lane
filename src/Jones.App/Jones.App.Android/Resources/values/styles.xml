<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <style name="MyTheme">
  </style>

  <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowBackground">@drawable/splash_screen</item>
    <item name="android:windowNoTitle">true</item>
    <!-- Fullscreen. The playfield is already pillarboxed or letterboxed in black by the
         Viewbox, and a status bar over one edge of that turns a symmetric black border
         into an asymmetric one. It also keeps a notification from landing on the game. -->
    <item name="android:windowFullscreen">true</item>
  </style>
</resources>
