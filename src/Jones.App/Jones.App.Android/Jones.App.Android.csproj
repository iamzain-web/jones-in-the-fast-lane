<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- 23 is what AudioTrack.Builder needs, and it is the template's own floor. -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.jones.fastlane</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <!-- ==================================================================
         THE DEBUG APK MUST STAND ALONE. THIS IS WHY IT WOULD NOT OPEN.

         .NET for Android defaults `EmbedAssembliesIntoApk` to FALSE in Debug. That is
         "fast deployment": the APK ships with the Mono runtime, the native libraries and
         the assets, and NO MANAGED ASSEMBLIES AT ALL - `dotnet build -t:Install` pushes
         those separately, over adb, into
         /data/data/com.jones.fastlane/files/.__override__/, and the build and the push are
         two halves of one operation.

         Sideload only the APK - copy it to the phone, tap it, or `adb install` it - and
         the second half never happens. The app installs, the launcher shows its icon, the
         process starts, the runtime finds no assemblies and dies before a single line of
         C# runs. There is nothing on screen and nothing to attribute it to: "installs and
         then does not open", exactly.

         Verified by opening the artefacts: the 43MB Debug APK built on 2026-09-28 had 923
         entries, 533 speech WAVs, jones-data.zip, 28 native .so files - and zero managed
         assemblies. The Release APK of the same tree carried
         `lib/<abi>/libassembly-store.so`, 6.7MB of them, because Release already embeds.

         True unconditionally rather than for Debug alone: an APK that behaves differently
         depending on how it was reached is the trap this file just fell into. The cost is
         a slower incremental deploy over USB, which nobody here does - both APKs are
         carried to the phone by hand.
         ================================================================== -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jones.App\Jones.App.csproj" />
    <!-- The OPL2 synthesiser. Portable net8.0, no platform APIs; this head supplies only
         the sink (AudioTrackStream), exactly as the Windows head supplies WaveOutStream. -->
    <ProjectReference Include="..\..\Jones.Audio\Jones.Audio.csproj" />
  </ItemGroup>

  <!-- ==================================================================
       ASSETS

       The desktop head finds `assets/` by walking up the directory tree from the
       executable. An APK has no tree to walk, so the assets have to be carried inside
       it. They are carried two different ways, because they are two different problems.

       1. SPEECH (533 WAVs, 21.5MB) ships as loose AndroidAssets under `speech/` and is
          NEVER copied out. Nothing in the shared code reads a speech file - the head's
          own IAudioPlayer does - so this head reads them straight off the AssetManager.
          `.wav` is on aapt's no-compress list, so they sit in the APK uncompressed and
          open instantly. Extracting them instead would cost a 21MB first-run copy and
          43MB of the phone's storage for no gain.

       2. EVERYTHING ELSE (raw/text, audio/sync, subtitles.json -
          about 300KB across ~620 files) is zipped at build time and unpacked into the
          app's private files directory on first run. This set has to become real FILES
          because the code that reads it is shared and takes a filesystem path:
          SciText.Load, LipSync.SetDirectory and Subtitles.Load
          all call System.IO.File. Rewriting those to take
          streams would mean changing Jones.App and Jones.Audio; unpacking 300KB does not.

       NOT SHIPPED: assets/png4x, the 24MB upscaled art. RenderScale falls back to Factor
       1 when no `png{N}x` directory is found, which is the original's own pixels blown up
       by the Viewbox with interpolation None - a legitimate look, and the one this first
       cut ships. To include it later, add it to JonesDataFile below (and expect the APK
       to roughly double); RenderScale.UseAssetRoot(GameAssets.Root(...)) in JonesRuntime
       is the other half.
       ================================================================== -->

  <PropertyGroup>
    <JonesAssetRoot>$(MSBuildThisFileDirectory)..\..\..\assets\</JonesAssetRoot>
    <JonesDataStage>$(MSBuildThisFileDirectory)obj\jonesdata\</JonesDataStage>
    <JonesDataZip>$(MSBuildThisFileDirectory)obj\jones-data.zip</JonesDataZip>
  </PropertyGroup>

  <ItemGroup>
    <!-- The speech clips, read through AssetManager by AndroidAudioPlayer. -->
    <AndroidAsset Include="$(JonesAssetRoot)audio\speech\*.wav"
                  Link="Assets\speech\%(Filename)%(Extension)" />

    <!-- The zip built by PackJonesData below. Declared as a literal path so the item
         survives evaluation on a clean tree, where the file does not exist yet. -->
    <AndroidAsset Include="$(JonesDataZip)" Link="Assets\jones-data.zip" />
  </ItemGroup>

  <ItemGroup>
    <!-- StagePath is the path the file must have INSIDE the zip, which is the path it
         must have under the asset root once unpacked - the shared loaders build
         `<root>/raw/text/<n>.text` and friends. -->
    <JonesDataFile Include="$(JonesAssetRoot)raw\text\*.text"      StagePath="raw\text\" />
    <JonesDataFile Include="$(JonesAssetRoot)audio\sync\*.sync"    StagePath="audio\sync\" />
    <JonesDataFile Include="$(JonesAssetRoot)audio\subtitles.json" StagePath="audio\" />
  </ItemGroup>

  <!--
    THIS PROJECT FILE IS AN INPUT, and leaving it out was a real bug that shipped.

    The Inputs used to be `@(JonesDataFile)` alone. That is fine while files are ADDED or
    edited, and silently wrong when a line is REMOVED: deleting the `raw\patch` and
    `raw\sound` entries left every remaining input older than the existing zip, so MSBuild
    judged the target up to date, skipped it, and packaged the PREVIOUS zip - still
    carrying all 34 of Sierra's arrangements and her instrument bank - into an APK built
    from a project that no longer mentions them. The build reported success and every
    other signal said the music was gone.

    Listing the project file itself means any change to the item list invalidates the
    output, which is what makes the note below true rather than aspirational.
  -->
  <Target Name="PackJonesData" BeforeTargets="BeforeBuild"
          Inputs="@(JonesDataFile);$(MSBuildProjectFullPath)" Outputs="$(JonesDataZip)">
    <!-- Cleared rather than merged, so a file deleted from assets/ leaves the zip too. -->
    <RemoveDir Directories="$(JonesDataStage)" />
    <Copy SourceFiles="@(JonesDataFile)"
          DestinationFiles="@(JonesDataFile->'$(JonesDataStage)%(StagePath)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(JonesDataStage)" DestinationFile="$(JonesDataZip)"
                  Overwrite="true" />
  </Target>
</Project>
