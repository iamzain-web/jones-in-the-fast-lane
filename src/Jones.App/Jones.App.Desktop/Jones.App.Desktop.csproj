<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jones.App\Jones.App.csproj" />
    <!--
      The SCI sound synthesiser. Portable on purpose: this head supplies only the
      waveOut plumbing, so an Android head reuses the same engine.
    -->
    <ProjectReference Include="..\..\Jones.Audio\Jones.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- System.Media.SoundPlayer, for the extracted 8-bit 11025 Hz speech WAVs. -->
    <PackageReference Include="System.Windows.Extensions" />
  </ItemGroup>
</Project>
