<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scoped to this project only. The machine-level config includes SSP's private
    Pure-Insurer feed, which requires credentials this project has no business holding
    and which fails restore with a 401. Clearing and using nuget.org alone keeps the
    build self-contained; nothing here needs an internal package.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
